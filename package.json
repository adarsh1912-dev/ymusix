{
  "name": "ymusix",
  "version": "1.1.0",
  "description": "A Spotify-inspired terminal music player - local-first, with optional YouTube",
  "keywords": [
    "music",
    "player",
    "terminal",
    "cli",
    "tui",
    "mpv",
    "youtube",
    "ink",
    "local-first"
  ],
  "type": "module",
  "bin": {
    "ymusix": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adarsh1912-dev/ymusix.git"
  },
  "homepage": "https://github.com/adarsh1912-dev/ymusix#readme",
  "bugs": {
    "url": "https://github.com/adarsh1912-dev/ymusix/issues"
  },
  "scripts": {
    "build": "node esbuild.config.js",
    "prepack": "npm run build",
    "dev": "node esbuild.config.js --watch",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "ink": "^8.0.0",
    "music-metadata": "^12.0.0",
    "react": "^19.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
